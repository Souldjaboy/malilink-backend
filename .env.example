# ============================================================
# MaliLink / Triangle WMS / Hafiya — Backend
# Copier ce fichier vers .env puis remplacer les valeurs.
# NE JAMAIS committer .env (il est dans .gitignore).
# ============================================================

# --- Serveur ---
PORT=5052
NODE_ENV=development

# --- Sécurité (OBLIGATOIRE en production, le serveur refuse de démarrer sans) ---
# Générer chaque secret séparément : openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# Signature des reçus Wallet — DOIT être différent de JWT_SECRET (Phase 0).
WALLET_RECEIPT_SECRET=CHANGE_ME_openssl_rand_hex_32_DIFFERENT
# Chiffrement au repos des secrets webhooks (AES-256-GCM), 32 octets hex.
# Optionnel : sans clé, les secrets webhooks restent en clair (format "plain").
WALLET_SECRET_ENC_KEY=CHANGE_ME_openssl_rand_hex_32
# Signature des billets MaliLink Voyage — distinct de WALLET_RECEIPT_SECRET
# et de JWT_SECRET (Lot 4).
TRAVEL_TICKET_SECRET=CHANGE_ME_openssl_rand_hex_32_DIFFERENT

# --- Base de données PostgreSQL ---
# MaliLink local :
DATABASE_URL=postgresql://malilink_user:CHANGE_ME_MOT_DE_PASSE@localhost:5432/malilink_global
# Triangle WMS :  postgresql://triangle_user:xxx@localhost:5432/triangle_wms
# Hafiya :        postgresql://hafiya_user:xxx@localhost:5432/hafiya_lab

# --- Pool PostgreSQL (Phase 0 — valeurs par défaut sûres si non définies) ---
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# --- Rate limiting (optionnel) ---
# Définir pour un rate-limit partagé multi-instances (sinon mémoire locale).
# Nécessite le paquet `redis`. Ex : redis://127.0.0.1:6379
REDIS_URL=

# --- Produit / tenant par défaut ---
DEFAULT_TENANT_ID=malilink

# --- URLs publiques ---
PUBLIC_BASE_URL=https://malilinkglobal.com
FRONTEND_URL=https://malilinkglobal.com
NEXT_PUBLIC_FRONTEND_URL=https://malilinkglobal.com
APP_URL=https://malilinkglobal.com

# --- IA (assistant) ---
OPENROUTER_API_KEY=

# --- Email ---
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS ---
SMS_PROVIDER=sandbox
SMS_API_KEY=
SMS_SENDER=

# --- Support ---
SUPPORT_WHATSAPP_NUMBER=

# --- Connexion sociale ---
SOCIAL_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_AUTH_URL=
INSTAGRAM_TOKEN_URL=
INSTAGRAM_USERINFO_URL=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_AUTH_URL=
TIKTOK_TOKEN_URL=
TIKTOK_USERINFO_URL=

# --- Paiements ---
PAYMENT_SETTINGS_SECRET=
CARD_PROVIDER_PUBLIC_KEY=
CARD_PROVIDER_SECRET_KEY=
ORANGE_MONEY_API_KEY=
MOOV_MONEY_API_KEY=
WAVE_API_KEY=

# Signature des documents Éducation (fiches, reçus, bulletins) — requis en prod.
EDU_DOC_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── Biométrie (visage, empreinte) — noyau biometrie/ ─────────────────────
# Clé de chiffrement des gabarits et des secrets d'appareils : 32 octets en
# hexadécimal (64 caractères), propre à chaque environnement, DIFFÉRENTE de
# JWT_SECRET. Sans elle, toute inscription biométrique est refusée (aucun
# repli). Rotation : BIOMETRIC_ENC_KEYS="k1:<hex>,k2:<hex>" + BIOMETRIC_ENC_KEY_ID=k2.
BIOMETRIC_ENC_KEY=
BIOMETRIC_ENC_KEYS=
BIOMETRIC_ENC_KEY_ID=
# Moteur de reconnaissance faciale LOCAL auto-hébergé (facultatif). Vide :
# le fournisseur « local » reste inactif. Aucun cloud biométrique.
FACE_ENGINE_URL=
FACE_ENGINE_TOKEN=
FACE_ENGINE_TIMEOUT_MS=8000
# Simulateur de tests : n'est accepté que si NODE_ENV=test. Jamais en production.
BIOMETRIC_ALLOW_MOCK=

# ── Passkeys (WebAuthn) ──────────────────────────────────────────────────
# Domaine exact servi aux navigateurs (sans schéma ni port) et origines
# autorisées, séparées par des virgules (https://…).
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
WEBAUTHN_RP_NAME=

# Les secrets des terminaux / agents biométriques ne sont PAS des variables :
# chaque appareil reçoit le sien à sa déclaration (affiché une fois, stocké
# chiffré). Limiteur de débit multi-instances : REDIS_URL (facultatif).

# Appels MaliLink Social (LiveKit) — laisser vide tant que rtc.malilinkglobal.com
# n'est pas en service ; voir deploy/livekit/README.md
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
