# LiveKit — serveur média des appels et directs MaliLink Social (un seul nœud).
# Copier vers /etc/livekit/livekit.yaml (propriétaire livekit, droits 600)
# APRÈS que rtc.malilinkglobal.com résout vers l'IP du VPS.
port: 7880                 # signalisation (WebSocket), uniquement en local, derrière Nginx (TLS)
bind_addresses:
  - 127.0.0.1
rtc:
  tcp_port: 7881           # média en TCP (réseaux qui bloquent l'UDP)
  udp_port: 7882           # média en UDP, un seul port multiplexé
  use_external_ip: true    # annonce l'IP publique du serveur
turn:
  # Relais TURN intégré : indispensable pour les réseaux mobiles / NAT stricts.
  enabled: true
  domain: rtc.malilinkglobal.com
  udp_port: 3478           # TURN/UDP
  tls_port: 5349           # TURN/TLS (certificat copié par le crochet certbot, voir README)
  relay_range_start: 30000 # ports UDP de relais (à ouvrir dans le pare-feu)
  relay_range_end: 40000
  cert_file: /etc/livekit/tls/fullchain.pem
  key_file: /etc/livekit/tls/privkey.pem
keys:
  # Générer : livekit-server generate-keys  (ne jamais commiter la vraie clé)
  CLE_API_A_REMPLACER: SECRET_API_A_REMPLACER_32_CARACTERES_MINIMUM
room:
  empty_timeout: 60        # salle fermée 60 s après le départ du dernier participant
  # Plafond PRUDENT par salle : les appels n'émettent que 2 jetons ; un direct
  # accepte au plus 100 personnes. Aucune capacité supérieure n'a été testée.
  max_participants: 100
logging:
  level: info
