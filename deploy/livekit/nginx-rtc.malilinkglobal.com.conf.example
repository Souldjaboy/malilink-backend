# /etc/nginx/sites-available/rtc.malilinkglobal.com
# Site DÉDIÉ : n'altère aucun autre site Nginx. À activer seulement quand
# « dig +short rtc.malilinkglobal.com » renvoie 72.62.232.24, puis :
#   certbot --nginx -d rtc.malilinkglobal.com
server {
    listen 80;
    server_name rtc.malilinkglobal.com;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name rtc.malilinkglobal.com;

    ssl_certificate     /etc/letsencrypt/live/rtc.malilinkglobal.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rtc.malilinkglobal.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:7880;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
